{
  "name": "scheduler-tp4-fairshare-dense-profile-retry",
  "port": 8260,
  "startup_timeout": 1200,
  "args": [
    "--tensor-parallel-size",
    "4",
    "--distributed-executor-backend",
    "mp",
    "--max-model-len",
    "131072",
    "--max-num-seqs",
    "64",
    "--max-num-batched-tokens",
    "4096",
    "--gpu-memory-utilization",
    "0.90",
    "--kv-cache-dtype",
    "fp8_ds_mla",
    "--block-size",
    "256",
    "--attention-backend",
    "FLASHINFER_MLA_SPARSE_DSV4",
    "--moe-backend",
    "marlin",
    "--no-enable-prefix-caching",
    "--seed",
    "20261105",
    "--reasoning-parser",
    "deepseek_v4",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "deepseek_v4",
    "--enable-chunked-prefill",
    "--long-prefill-token-threshold",
    "2048",
    "--enable-logging-iteration-details",
    "--profiler-config",
    "{\"profiler\": \"torch\", \"torch_profiler_dir\": \"${RUN_DIR}/profiles\", \"torch_profiler_activities\": [\"CPU\", \"CUDA\"], \"torch_profiler_with_stack\": false, \"torch_profiler_record_shapes\": false, \"torch_profiler_with_memory\": false, \"detailed_trace_annotation\": false, \"ignore_frontend\": true, \"delay_iterations\": 0, \"max_iterations\": 0, \"warmup_iterations\": 0, \"wait_iterations\": 0}",
    "--scheduler-cls",
    "research_scheduler.FairShareResearchScheduler",
    "--prefill-schedule-interval",
    "8"
  ],
  "env": {
    "NCCL_DEBUG": "WARN",
    "VLLM_SERVER_DEV_MODE": "1"
  },
  "profile_control_timeout_s": 600
}
