{
  "name": "dp4-ep-marlin-apc-128k",
  "port": 8260,
  "startup_timeout": 1200,
  "args": [
    "--tensor-parallel-size",
    "1",
    "--distributed-executor-backend",
    "mp",
    "--max-model-len",
    "131072",
    "--max-num-seqs",
    "64",
    "--max-num-batched-tokens",
    "4096",
    "--gpu-memory-utilization",
    "0.90",
    "--kv-cache-dtype",
    "fp8_ds_mla",
    "--block-size",
    "256",
    "--attention-backend",
    "FLASHINFER_MLA_SPARSE_DSV4",
    "--moe-backend",
    "marlin",
    "--enable-prefix-caching",
    "--seed",
    "20261105",
    "--data-parallel-size",
    "4",
    "--enable-expert-parallel",
    "--all2all-backend",
    "allgather_reducescatter",
    "--reasoning-parser",
    "deepseek_v4",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "deepseek_v4"
  ],
  "env": {
    "NCCL_DEBUG": "WARN"
  }
}
